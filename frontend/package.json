    "@sveltejs/vite-plugin-svelte": "^4",
    "@testing-library/svelte": "^5",
    "@tsconfig/svelte": "^5",
    "eslint": "^9",
    "eslint-plugin-svelte": "^2",
    "jsdom": "^25",
    "prettier": "^3",
    "prettier-plugin-svelte": "^3",
    "svelte": "^5",
    "svelte-check": "^4",
    "typescript": "^5",

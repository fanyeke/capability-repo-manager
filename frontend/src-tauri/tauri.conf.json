{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/a40fe7f6f8869d3c944c1915af2c0e18b617a580/crates/tauri-cli/schema.json",
  "productName": "能力仓库管理器",
  "version": "0.1.0",
  "identifier": "com.capability-repo-manager.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "能力仓库管理器",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon_32.png",
      "icons/icon_128.png",
      "icons/icon_256.png"
    ]
  }
}
